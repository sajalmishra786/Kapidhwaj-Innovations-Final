# Contact form settings for the Vercel function (api/send.ts).
# Set these in Vercel → Project → Settings → Environment Variables, then redeploy.
# Never commit real values. (.env and .env.local are gitignored.)

# ── Required ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_USER=contact@kapidhwajinnovations.com
# Gmail: an App Password, not the account password.
SMTP_PASS=
MAIL_TO=contact@kapidhwajinnovations.com

# ── Optional (defaults shown) ─────────────────────────────────────────────
# 587 + tls (STARTTLS) or 465 + ssl. Hostinger mail: smtp.hostinger.com 465 ssl.
SMTP_PORT=587
SMTP_SECURE=tls
# Must be an address SMTP_USER may send as. Defaults to SMTP_USER.
MAIL_FROM=
MAIL_FROM_NAME=Kapidhwaj Website
MAIL_TO_NAME=Kapidhwaj Innovations
MAIL_CC=
MAIL_BCC=
SEND_AUTOREPLY=true
RATE_LIMIT_SECONDS=30
# Extra origins allowed to POST cross-site, comma-separated.
# The site's own domain (incl. Vercel preview URLs) is always allowed.
ALLOWED_ORIGINS=https://kapidhwajinnovations.com,https://www.kapidhwajinnovations.com
